@using RIOMS.Domain;
@model RIOMS.WebUI.Models.ReceiptViewModel

    @{
        ViewBag.Title = "Index";
    }

    <h2>Index</h2>
    <table class="villageWari">
        <tr>
            <th rowspan="2" class="date">
                Date
            </th>
            <th rowspan="2">
                Receipt No
            </th>
            <th rowspan="2">
                Khata No
            and
                Name Of Tanent
            </th>
            <th colspan="7">
                Land Revenue
            </th>
            <th colspan="7">
                Water Tax
            </th>
            <th colspan="7">
                CollectionCess
            </th>

            <th rowspan="2">Interest On LR</th>
            <th rowspan="2">Interest On CBWR</th>
            <th rowspan="2">Interest On Cess</th>
            <th>CollectionOther</th>
            <th rowspan="2">Grand Total</th>
        </tr>
        <tr>
            <th>
                More Than Three
            </th>
            <th>
                Third
            </th>
            <th>
                Second
            </th>
            <th>
                Previous
            </th>
            <th>
                Current
            </th>
            <th></th>
            <th>Total</th>
            <th>
                More Than Three
            </th>
            <th>
                Third
            </th>
            <th>
                Second
            </th>
            <th>
                Previous
            </th>
            <th>
                Current
            </th>
            <th></th>
            <th>Total</th>
            <th>
                More Than Three
            </th>
            <th>
                Third
            </th>
            <th>
                Second
            </th>
            <th>
                Previous
            </th>
            <th>
                Current
            </th>
            <th></th>

            <th>Total</th>

        </tr>
        @{
            Receipt total;
            Receipt grandTotal = null;
            Receipt previousTotal;
        }
        @for (int i = 0; i < Model.Totals.Count(); i++)
{
    total = Model.Totals.ElementAt(i);

    if (i == 0)
    {
        grandTotal = total;
    }
    var receipts = Model.Receipts.Where(r => r.Date == total.Date).ToList();
    foreach (var item in receipts)
    {
        var index = receipts.IndexOf(item);
        <tr class="@(index%2==0? "row-even" : "row-odd")">
            <td class="date">
                @item.Date.ToString("dd/MM/yy")
            </td>
            <td>@Html.DisplayFor(modelItem => item.ReceiptNo)</td>
            <td class="nameOfRT">
                @Html.DisplayFor(modelItem => item.KhataNo)

                @Html.DisplayFor(modelItem => item.NameOfRT)
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionWaterTax.MoreThanThree)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionWaterTax.Third)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionWaterTax.Second)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionWaterTax.Previous)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionWaterTax.Current)
            </td>
            <td></td>
            <td>@Html.DisplayFor(modelItem => item.CollectionWaterTax.Total)</td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionCess.MoreThanThree)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionCess.Third)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionCess.Second)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionCess.Previous)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CollectionCess.Current)
            </td><td></td>
            <td>@Html.DisplayFor(modelItem => item.CollectionCess.Total)</td>
            <td>@Html.DisplayFor(modelItem => item.CollectionLandRevenue.InterestTotal)</td>
            <td>@Html.DisplayFor(modelItem => item.CollectionWaterTax.InterestTotal)</td>
            <td>@Html.DisplayFor(modelItem => item.CollectionCess.InterestTotal)</td>
            <td>@Html.DisplayFor(modelItem => item.CollectionOther.Amount)</td>
            <td>@Html.DisplayFor(modelItem => item.Total)</td>
        </tr>
    }
            <tr class="total">
                <td colspan="3">Total</td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionWaterTax.MoreThanThree)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionWaterTax.Third)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionWaterTax.Second)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionWaterTax.Previous)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionWaterTax.Current)
                </td>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionWaterTax.Total)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionCess.MoreThanThree)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionCess.Third)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionCess.Second)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionCess.Previous)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionCess.Current)
                </td>
                <td></td>
                <td>
                    @Html.DisplayFor(modelItem => total.CollectionCess.Total)
                </td>
                <td>@Html.DisplayFor(modelItem => total.CollectionLandRevenue.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => total.CollectionWaterTax.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => total.CollectionCess.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => total.CollectionOther.Amount)</td>
                <td>@Html.DisplayFor(modelItem => total.Total)</td>
            </tr>
            if (i > 0)
            {

                previousTotal = grandTotal;
                <tr class="total">
                    <td colspan="3">Previous Total</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionWaterTax.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionWaterTax.Third)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionWaterTax.Second)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionWaterTax.Previous)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionWaterTax.Current)
                    </td><td></td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionWaterTax.Total)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Third)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Second)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Previous)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Current)
                    </td><td></td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Total)
                    </td>
                    <td>@Html.DisplayFor(modelItem => previousTotal.CollectionLandRevenue.InterestTotal)</td>
                    <td>@Html.DisplayFor(modelItem => previousTotal.CollectionWaterTax.InterestTotal)</td>
                    <td>@Html.DisplayFor(modelItem => previousTotal.CollectionCess.InterestTotal)</td>
                    <td>@Html.DisplayFor(modelItem => previousTotal.CollectionOther.Amount)</td>
                    <td>@Html.DisplayFor(modelItem => previousTotal.Total)</td>
                </tr>

                grandTotal = previousTotal + total;
                <tr class="total">
                    <td colspan="3">Grand Total</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionWaterTax.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionWaterTax.Third)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionWaterTax.Second)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionWaterTax.Previous)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionWaterTax.Current)
                    </td><td></td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionWaterTax.Total)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionCess.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionCess.Third)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionCess.Second)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionCess.Previous)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionCess.Current)
                    </td>
                    <td></td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionCess.Total)
                    </td>
                    <td>@Html.DisplayFor(modelItem => grandTotal.CollectionLandRevenue.InterestTotal)</td>
                    <td>@Html.DisplayFor(modelItem => grandTotal.CollectionWaterTax.InterestTotal)</td>
                    <td>@Html.DisplayFor(modelItem => grandTotal.CollectionCess.InterestTotal)</td>
                    <td>@Html.DisplayFor(modelItem => grandTotal.CollectionOther.Amount)</td>
                    <td>@Html.DisplayFor(modelItem => grandTotal.Total)</td>
                </tr>
            }

        }






    </table>
