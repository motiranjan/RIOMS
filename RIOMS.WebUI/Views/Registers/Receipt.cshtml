@{
    ViewBag.Title = "Index";
}
<div id="receipt" ng-app="RIOMS" ng-controller="ReceiptController">
    <div>
        <input type="date" ng-model="CurrentDate" style="width:200px" ng-change="LoadReceipts()" />
       
    </div>
    <div ng-repeat="receipt in Receipts track by $index">
        <table class="register">
            <tr>
                <td>{{receipt.Date}}</td>
                <td>Villge</td>
                <td colspan="2">
                    @Html.DropDownList("village", (SelectList)ViewBag.Villages, new { ng_model = "receipt.VillageId", ng_change = "GetRT(receipt)", Tabindex = "{{($index*12)+2}}" })
                </td>
                <td>khata No</td>
                <td>
                    <input type="text" ng-model="receipt.KhataNo" ng-keyup="GetRT(receipt)" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.ReceiptNo" tabindex="{{($index*12)+1}}" />
                </td>
            </tr>
            <tr>
                <td colspan="2">Name Of RT</td>

                <td colspan="6" class="nameOfRT">{{receipt.NameOfRT}}</td>
            </tr>
            <tr>
                
                <td><label for="CollectionLandRevenue{{$index}}">Land Revenue</label></td>
                <td><input type="checkbox" id="CollectionLandRevenue{{$index}}" ng-model="receipt.HasLandRevenue" ng-change="LoadLR(receipt)" /> </td>
                <td><label for="CollectionWaterTax{{$index}}">Water Tax</label></td>
                <td><input type="checkbox" id="CollectionWaterTax{{$index}}" ng-model="receipt.HasWaterTax" ng-change="LoadCBWR(receipt)" /></td>
                <td><label for="CollectionCess{{$index}}">CollectionCess</label></td>
                <td><input type="checkbox" id="CollectionCess{{$index}}" ng-model="receipt.HasCess" ng-change="LoadCess(receipt)" /></td>
                <td><label for="CollectionMiscRevenue{{$index}}">Misc Revenue</label></td>
            
                
                
               
                <td><input type="checkbox" id="CollectionMiscRevenue{{$index}}" ng-model="receipt.HasMiscRevenue" ng-change="LoadMiscRevenue(receipt)" /></td>
            </tr>
        


            <tr>
                <td></td>
                <td>3 years and above</td>
                <td>Third year</td>
                <td>Second</td>
                <td>Previous</td>
                <td>Current</td>
                <td>Total</td>
                <td>Interest</td>
            </tr>
            <tr ng-if="receipt.HasLandRevenue">
                <td>Land Revenue</td>
                <td>
                    <input type="text" ng-model="receipt.CollectionLandRevenue.MoreThanThree" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionLandRevenue.Third" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionLandRevenue.Second" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionLandRevenue.Previous" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionLandRevenue.Current" />
                </td>
                <td>
                    {{Total(receipt.CollectionLandRevenue)}}
                </td>
                <td><input type="text" ng-model="receipt.CollectionLandRevenue.InterestTotal" /></td>
               
            </tr>
            <tr ng-if="receipt.HasWaterTax">
                <td>Water Tax</td>
                <td>
                    <input type="text" ng-model="receipt.CollectionWaterTax.MoreThanThree" tabindex="{{($index*12)+12}}" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionWaterTax.Third" tabindex="{{($index*12)+11}}" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionWaterTax.Second" tabindex="{{($index*12)+10}}" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionWaterTax.Previous" tabindex="{{($index*12)+9}}" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionWaterTax.Current" tabindex="{{($index*12)+8}}" />
                </td>
                <td>
                    {{Total(receipt.CollectionWaterTax)}}
                </td>
                <td><input type="text" ng-model="receipt.CollectionWaterTax.InterestTotal" /></td>
            </tr>

            <tr ng-if="receipt.HasCess">
                <td>
                    CollectionCess
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionCess.MoreThanThree" tabindex="{{($index*12)+7}}" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionCess.Third" tabindex="{{($index*12)+6}}" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionCess.Second" tabindex="{{($index*12)+5}}" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionCess.Previous" tabindex="{{($index*12)+4}}" />
                </td>
                <td>
                    <input type="text" ng-model="receipt.CollectionCess.Current" tabindex="{{($index*12)+3}}" />
                </td>
                <td>
                    {{Total(receipt.CollectionCess)}}
                </td>
                <td><input type="text" ng-model="receipt.CollectionCess.InterestTotal" /></td>
            </tr>
            <tr ng-if="receipt.HasMiscRevenue">
                <td >Misc Revenue</td>
                <td colspan="5"><input type="text" ng-model="receipt.CollectionMiscRevenue.Arrear" /></td>
                <td ><input type="text" ng-model="receipt.CollectionMiscRevenue.Current" /></td>
                <td ><input type="text" ng-model="receipt.CollectionMiscRevenue.Interest" /></td>
            </tr>
        </table>
        <a href="#" ng-click="RemoveReceipt()">Delete</a>
    </div>


    <input type="button" name="name" value="Save" ng-click="SaveReceipts()" />
    <input type="button" ng-click="AddReceipt()" value="Add" />
</div>

