                    olr = new IFormDetailOLR { VillageId = village.Id, Year = Model.Year, IFormNo = Model.IFormNo };
                }
                if (cess == null)
                {
                    cess = new IFormDetailCess { VillageId = village.Id, Year = Model.Year, IFormNo = Model.IFormNo };
                }
                if (other == null)
                {
                    other = new IFormDetailOther { VillageId = village.Id, Year = Model.Year, IFormNo = Model.IFormNo };
                }

                <tr style="font-family:OR-TTSarala;font-size:22px;font-weight:bolder;">

