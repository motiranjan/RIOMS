                        }
                    </td>
                    <td>
                        @if (cess.Current > 0)
                        {
                            @Html.DisplayFor(modelItem => cess.Current)
                        }
                    </td>

                    <td>
                        @{decimal tc = cess.MoreThanThree.GetValueOrDefault() + cess.Third.GetValueOrDefault() + cess.Second.GetValueOrDefault() + cess.Previous.GetValueOrDefault() + cess.Current.GetValueOrDefault();}
                        @if (tc > 0)
                        {
                            @tc
