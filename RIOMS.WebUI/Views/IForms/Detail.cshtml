            IFormDetailLandRevenue landRevenue = Model.IFormDetailLandRevenues.SingleOrDefault(v => v.VillageId == village.Id);

            IFormDetailWaterTax waterTax = Model.IFormDetailWaterTaxes.SingleOrDefault(v => v.VillageId == village.Id);

            IFormDetailMiscRevenue miscRevenue = Model.IFormDetailMiscRevenues.SingleOrDefault(v => v.VillageId == village.Id);

            IFormDetailOLR olr = Model.IFormDetailOLRs.SingleOrDefault(v => v.VillageId == village.Id);

            IFormDetailCess cess = Model.IFormDetailCesses.SingleOrDefault(v => v.VillageId == village.Id);

            IFormDetailOther other = Model.IFormDetailOthers.SingleOrDefault(v => v.VillageId == village.Id);

            if (!(landRevenue == null && waterTax == null && cess == null && miscRevenue == null && other == null && olr == null))
