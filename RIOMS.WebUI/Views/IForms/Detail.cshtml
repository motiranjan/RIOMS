                            @Html.DisplayFor(modelItem => waterTax.Previous)
                        }
                    </td>
                    <td>

                        @if (waterTax.Current > 0)
                        {
                            @Html.DisplayFor(modelItem => waterTax.Current)
                        }
                    </td>

                    <td>
                        @{decimal tw = waterTax.MoreThanThree.GetValueOrDefault() + waterTax.Third.GetValueOrDefault() + waterTax.Second.GetValueOrDefault() + waterTax.Previous.GetValueOrDefault() + waterTax.Current.GetValueOrDefault();}
                        @if (tw > 0)
