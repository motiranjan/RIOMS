                    </td>
                    <td>
                        @if (miscRevenue.Arrear > 0)
                        {

                            @Html.DisplayFor(modelItem => miscRevenue.Arrear)
                        }
                    </td>
                    <td>

                        @if (miscRevenue.Current > 0)
                        {
                            @(miscRevenue.Current)
                        }
                    </td>
                    <td>
                        @if (landRevenue.InterestTotal > 0)
                        {
                            @Html.DisplayFor(modelItem => landRevenue.InterestTotal)
                        }
                    </td>
                    <td>
                        @if (waterTax.InterestTotal > 0)
                        {
                            @Html.DisplayFor(modelItem => waterTax.InterestTotal)
                        }
                    </td>
                    <td>
                        @if (cess.InterestTotal > 0)
                        {
                            @Html.DisplayFor(modelItem => cess.InterestTotal)
                        }
                    </td>
                    <td>
                        @if (miscRevenue.Interest > 0)
                        {
                            @Html.DisplayFor(modelItem => miscRevenue.Interest)
                        }
                    </td>
                    <td>
                        @{Decimal df = olr.DemarcationFee.GetValueOrDefault() + other.Amount.GetValueOrDefault();}

                        @if (df > 0)
                        {
                            @df
                        }
                    </td>

                    <td>
                        @{decimal total = tlr + tw + tc + miscRevenue.Arrear.GetValueOrDefault() + miscRevenue.Current.GetValueOrDefault() + landRevenue.InterestTotal.GetValueOrDefault() + waterTax.InterestTotal.GetValueOrDefault() + cess.InterestTotal.GetValueOrDefault() + miscRevenue.Interest.GetValueOrDefault() + df + olr.Premium.GetValueOrDefault();
                            gt = gt + total;
                        }
                        @total
                    </td>
                </tr>
            }
        }
