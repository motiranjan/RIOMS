    <div>

        @{
            decimal arrearLR = Model.IFormDetailLandRevenues.Sum(lr => lr.MoreThanThree + lr.Third + lr.Second + lr.Previous).GetValueOrDefault();
            decimal currentLR = Model.IFormDetailLandRevenues.Sum(lr => lr.Current).GetValueOrDefault();
            decimal arrearCBWR = Model.IFormDetailWaterTaxes.Sum(cbwr => cbwr.MoreThanThree + cbwr.Third + cbwr.Second + cbwr.Previous).GetValueOrDefault();
            decimal currentCBWR = Model.IFormDetailWaterTaxes.Sum(cbwr => cbwr.Current).GetValueOrDefault();
            decimal arrearCess = Model.IFormDetailCesses.Sum(cess => cess.MoreThanThree + cess.Third + cess.Second + cess.Previous).GetValueOrDefault();
            decimal currentCess = Model.IFormDetailCesses.Sum(cess => cess.Current).GetValueOrDefault();
            decimal interestLR = Model.IFormDetailLandRevenues.Sum(lr => lr.InterestTotal).GetValueOrDefault();
            decimal interestCess = Model.IFormDetailCesses.Sum(cess => cess.InterestTotal).GetValueOrDefault();
            decimal interestCBWR = Model.IFormDetailWaterTaxes.Sum(cbwr => cbwr.InterestTotal).GetValueOrDefault();
            decimal arrearMisc = Model.IFormDetailMiscRevenues.Sum(m => m.Arrear).GetValueOrDefault();
            decimal currentMisc = Model.IFormDetailMiscRevenues.Sum(m => m.Current).GetValueOrDefault();
            decimal intMisc = Model.IFormDetailMiscRevenues.Sum(m => m.Interest).GetValueOrDefault();
            decimal olrpremium = Model.IFormDetailOLRs.Sum(o => o.Premium).GetValueOrDefault();
        }
        <br />
        <br />
        <div id="abstract">
            <span>Abstract</span>
            @if (arrearLR > 0)
            {
                <div><span>Arrear LR </span><span>@arrearLR</span></div>
            }
            @if (currentLR > 0)
            {
                <div><span>Current LR </span><span>@currentLR</span></div>
            }
            @if (arrearCBWR > 0)
            {
                <div><span>Arrear CBWR </span><span>@arrearCBWR</span></div>
            }
            @if (currentCBWR > 0)
            {
                <div><span>Current CBWR </span><span>@currentCBWR</span></div>
            }

            @if (arrearCess > 0)
            {
                <div><span>Arrear Cess </span><span>@arrearCess</span></div>
            }
            @if (currentCess > 0)
            {
                <div><span>Current Cess </span><span>@currentCess</span></div>
            }
            @if (interestLR > 0)
            {
                <div><span>Interest On LR </span><span>@interestLR</span></div>
            }
            @if (interestCBWR > 0)
            {
                <div><span>Interest On CBWR </span><span>@interestCBWR</span></div>
            }
            @if (interestCess > 0)
            {
                <div><span>Interest On Cess </span><span>@interestCess</span></div>
            }
            @if (arrearMisc > 0)
            {
                <div><span>Arrear Misc Revenue </span><span>@arrearMisc</span></div>
            }
            @if (currentMisc > 0)
            {
                <div><span>Current Misc Revenue </span><span>@(currentMisc+olrpremium)</span></div>
            }
            @if (intMisc > 0)
            {
                <div><span>Intrest on Misc Revenue </span><span>@intMisc</span></div>
            }
            @if (dft > 0)
            {
                <div><span>Demarcation Fee </span><span>@dft</span></div>
            }

            <hr />
            @{ decimal gtotal = arrearLR + currentLR + interestLR + arrearCBWR + currentCBWR + interestCBWR + arrearMisc + intMisc + currentMisc + arrearCess + currentCess + interestCess + dft + olrpremium; }
            <div style="color:red;"><span>Total </span><span>@gtotal</span></div>
        </div>
        <br />

        <div class="word">@RIOMS.WebUI.Util.Util.ConvertAmountToWordOdia(gtotal)</div>
        <br />
        <div id="dur">ତା <span class="date">@Model.FromDate.ToShortDateString()</span> ରୁ ତା <span class="date">@Model.ToDate.ToShortDateString()</span> ପର୍ଯ୍ୟନ୍ତ ସମସ୍ତ ଅସୁଲି ଏହି ଚାଲାଣ ରେ ଜମା କରାଗଲା</div>
        <br />
        <br />
        <div id="receive">Received Rs. @gtotal (@RIOMS.WebUI.Util.Util.ConvertAmountToWords(gtotal)) vide MR No.________________________ dated_________________________ Book No.__________________________</div>
    </div>
</div>
