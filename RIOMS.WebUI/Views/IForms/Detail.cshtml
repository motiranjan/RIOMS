                    </td>

                    <td>
                        @{decimal tlr = landRevenue.MoreThanThree.GetValueOrDefault() + landRevenue.Third.GetValueOrDefault() + landRevenue.Second.GetValueOrDefault() + landRevenue.Previous.GetValueOrDefault() + landRevenue.Current.GetValueOrDefault();}
