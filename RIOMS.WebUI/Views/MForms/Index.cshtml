        <td>	13	</td>
        <td>	14	</td>
        <td>	15	</td>
        <td>	16	</td>
        <td>	17	</td>
        <td>	18	</td>
        <td>	19	</td>
 

    </tr>
    @foreach (var item in Model)
    {
        var index = Model.ToList().IndexOf(item);
        <tr class="@(index%2==0? "row-even" : "row-odd")">

            <td>@(index + 1)</td>
            
            <td class="nameOfRT">

                @if (item.NameOfRT != null)
                {

                    if (item.NameOfRT.Length > 20)
                    {
                        @item.NameOfRT.Substring(0, 20)
                    }
                    else
                    {
                        @item.NameOfRT
                    }
                }
            </td>
            <td>@Html.DisplayFor(modelItem => item.KhataNo)</td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
          
            <td>
                @if (item.CBWR.MoreThanThree > 0)
                {
                    @item.CBWR.MoreThanThree
                }
            </td>
            <td>
                @if (item.CBWR.Third > 0)
                {
                    @item.CBWR.Third
                }
            </td>
            <td>
                @if (item.CBWR.Second > 0)
                {
                    @item.CBWR.Second;
                }
            </td>
            <td>
                @if (item.CBWR.Previous > 0)
                {
                    @item.CBWR.Previous
                }
            </td>
            <td>
                @if (item.CBWR.Current > 0)
                {
                    @item.CBWR.Current;
                }
            </td>
            
            <td>
                @if (item.Cess.MoreThanThree > 0)
                {
                    @item.Cess.MoreThanThree
                }
            </td>
            <td>
                @if (item.Cess.Third > 0)
                {
                    @item.Cess.Third
                }
            </td>
            <td>
                @if (item.Cess.Second > 0)
                {
                    @item.Cess.Second;
                }
            </td>
            <td>
                @if (item.Cess.Previous > 0)
                {
                    @item.Cess.Previous
                }
            </td>
            <td>
                @if (item.Cess.Current > 0)
                {
                    @item.Cess.Current;
                }
            </td>

        </tr>
    }
    <tr style="color:red;">

        <td></td>
        <td class="nameOfRT">

           
        </td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td>
            @*@Html.DisplayFor(modelItem => item.MoreThanThree)*@
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Third)*@
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Second)*@
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Previous)*@
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Current)*@
        </td>
        <td></td>
        <td>@*@Html.DisplayFor(modelItem => item.CollectionWaterTax.Total)*@</td>
        <td>
            @*@if (Model.Total.MoreThanThree > 0)
            {
                @Model.Total.MoreThanThree
            }*@
        </td>
        <td>
            @*@if (Model.Total.Third > 0)
            {
                @Model.Total.Third
            }*@
        </td>
        <td>
            @*@if (Model.Total.Second > 0)
            {
                @Model.Total.Second;
            }*@
        </td>
        <td>
            @*@if (Model.Total.Previous > 0)
            {
                @Model.Total.Previous
            }*@
        </td>
        <td>
            @*@if (Model.Total.Current > 0)
            {
                @Model.Total.Current;
            }*@
        </td>

    </tr>

</table>
