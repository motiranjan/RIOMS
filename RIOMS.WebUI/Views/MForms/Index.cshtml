@using RIOMS.Domain;
@model IEnumerable<Defaulter>
@{
    ViewBag.Title = "MFORM";
}

<h2>MFORM</h2>

<table class="villageWari">
    <tr>

        <th rowspan="2">SL No.</th>
        
        <th rowspan="2">
            Name Of Tanent
        </th>
        <th rowspan="2">
            Khata No
        </th>
        <th colspan="5">
            Land Revenue
        </th>
        <th colspan="5">
            Water Tax
        </th>
        <th colspan="5">
            Cess
        </th>


    </tr>
    <tr>
        <th>
