@model RIOMS.WebUI.Models.MFormAbstractViewModel

@{
    ViewBag.Title = "Abstract";
}

<h2>Abstract</h2>
<table class="villageWari">
    <tr>

        <th rowspan="2">SL No.</th>

        <th rowspan="2">
            Name Of Tanent
        </th>
        <th rowspan="2">
            Khata No
        </th>
        <th colspan="5">
            Land Revenue
        </th>
        <th colspan="5">
            Water Tax
        </th>
        <th colspan="5">
            Cess
        </th>


    </tr>
    <tr>
        <th>
            More Than Three
        </th>
        <th>
            Third
        </th>
        <th>
            Second
        </th>
        <th>
            Previous
        </th>
        <th>
            Current
        </th>

        <th>
            More Than Three
        </th>
        <th>
            Third
        </th>
        <th>
            Second
        </th>
        <th>
            Previous
        </th>
        <th>
            Current
        </th>

        <th>
            More Than Three
        </th>
        <th>
            Third
        </th>
        <th>
            Second
        </th>
        <th>
            Previous
        </th>
        <th>
            Current
        </th>


    </tr>
    <tr>
        <td>1</td>
        <td>2</td>
        <td>3</td>
        <td>	5	</td>
        <td>	6	</td>
        <td>	7	</td>
        <td>	8	</td>
        <td>	9	</td>
        <td>	10	</td>
        <td>	11	</td>
        <td>	12	</td>
        <td>	13	</td>
        <td>	14	</td>
        <td>	15	</td>
        <td>	16	</td>
        <td>	17	</td>
        <td>	18	</td>
        <td>	19	</td>


    </tr>
    @{
        int index = 0;
    }
    @foreach (var item in Model.DCBViewModels)
    {
        { index++; }
        <tr class="@(index%2==0? "row-even" : "row-odd")">

            <td>@(index + 1)</td>

            <td class="nameOfRT">
                @item.Village.Name
                
            </td>
            <td></td>
            <td>@item.BalanceLandRevenue.MoreThanThree</td>
            <td>@item.BalanceLandRevenue.Third</td>
            <td>@item.BalanceLandRevenue.Second</td>
            <td>@item.BalanceLandRevenue.Previous</td>
            <td>@item.BalanceLandRevenue.Current</td>

            <td>
                @if (item.BalanceWaterTax.MoreThanThree > 0)
                {
                    @item.BalanceWaterTax.MoreThanThree
                }
            </td>
            <td>
                @if (item.BalanceWaterTax.Third > 0)
                {
                    @item.BalanceWaterTax.Third
                }
            </td>
            <td>
                @if (item.BalanceWaterTax.Second > 0)
                {
                    @item.BalanceWaterTax.Second;
                }
            </td>
            <td>
                @if (item.BalanceWaterTax.Previous > 0)
                {
                    @item.BalanceWaterTax.Previous
                }
            </td>
            <td>
                @if (item.BalanceWaterTax.Current > 0)
                {
                    @item.BalanceWaterTax.Current;
                }
            </td>

            <td>
                @if (item.BalanceCess.MoreThanThree > 0)
                {
                    @item.BalanceCess.MoreThanThree
                }
            </td>
            <td>
                @if (item.BalanceCess.Third > 0)
                {
                    @item.BalanceCess.Third
                }
            </td>
            <td>
                @if (item.BalanceCess.Second > 0)
                {
                    @item.BalanceCess.Second;
                }
            </td>
            <td>
                @if (item.BalanceCess.Previous > 0)
                {
                    @item.BalanceCess.Previous
                }
            </td>
            <td>
                @if (item.BalanceCess.Current > 0)
                {
                    @item.BalanceCess.Current;
                }
            </td>

        </tr>
    }
    <tr style="color:red;">

        <td></td>
        <td class="nameOfRT"></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
       <td></td>
        <td>
            @Model.CBWRTotal.MoreThanThree
        </td>
        <td>
            @Model.CBWRTotal.Third
        </td>
        <td>
            @Model.CBWRTotal.Second
        </td>
        <td>
            @Model.CBWRTotal.Previous
        </td>
        <td>
            @Model.CBWRTotal.Current
        </td>
       
        <td>
            @Model.CessTotal.MoreThanThree
        </td>
        <td>
            @Model.CessTotal.Third
        </td>
        <td>
            @Model.CessTotal.Second
        </td>
        <td>
            @Model.CessTotal.Previous
        </td>
        <td>
           @Model.CessTotal.Current
        </td>

    </tr>

</table>