    }


</td>
<td>
    @Model.TotalCollectionWaterTax.Current
<span>(+)@Model.TotalAdvanceAdjustmentWaterTax.Current</span>
<hr />
<span>@(Model.TotalCollectionWaterTax.Current + Model.TotalAdvanceAdjustmentWaterTax.Current)</span>
</td>

<td>

    @Model.TotalCollectionCess.Current
    <span>(+)@Model.TotalAdvanceAdjustmentCess.Current</span>
    <hr />
    <span>@(Model.TotalCollectionCess.Current + Model.TotalAdvanceAdjustmentCess.Current)</span>
</td>
<td></td>
<td>
    @Model.TotalCollectionPartOneRev.Current
    <span>(+)@(Model.TotalAdvanceAdjustmentCess.Current+Model.TotalAdvanceAdjustmentWaterTax.Current)</span>
    <hr />
