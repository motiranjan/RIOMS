                @if (item.DemandLandRevenue.Current > 0)
                {
                    @item.DemandLandRevenue.Current
                }
                @if (item.IncreaseInDemandLandRevenue != null)
                {
                    <span style="color:red;">+@item.IncreaseInDemandLandRevenue.Current</span>
                    <br />
                    <span>---------</span>
                    <br />
                    <span>@item.DemandAfterIncreaseLandRevenue.Current</span>
                }
            </td>
        <td>@if (item.DemandWaterTax.Current>0)
            {
               @item.DemandWaterTax.Current 
            }</td>
        <td>

            @item.DemandCess.Current
            @if (item.IncreaseInDemandCess != null)
            {
                <span style="color:red;">+@item.IncreaseInDemandCess.Current</span>
                <br />
                <span>---------</span>
                <br />
                <span>@item.DemandAfterIncreaseCess.Current</span>
            }
        </td>
        <td></td>
        <td>
            @item.DemandPartOneRev.Current
            @if (item.IncreaseInDemandCess != null)
            {
                <span style="color:red;">+@item.IncreaseInDemandPartOneRev.Current</span>
                <br />
                <span>---------</span>
                <br />
                <span>@item.DemandAfterIncreasePartOneRev.Current</span>
            }
        </td>
        <td>
            @if (item.NetCollectionLandRevenue.Arrear > 0)
            {
                @item.NetCollectionLandRevenue.Arrear
            }
            <br />

            @if (item.AdvanceAdjustmentLandRevenue != null)
            {
        <span style="color:red;">
            +@item.AdvanceAdjustmentLandRevenue.Arrear
        </span>
            }
            <br />
            <span>---------</span>
            @item.NetCollectionWithAdvAdjLandRevenue.Arrear
       
</td>
        <td>@if (item.NetCollectionWaterTax.Arrear>0)
            {
                @item.NetCollectionWaterTax.Arrear
            }</td>

        <td>
            @if (item.NetCollectionCess.Arrear > 0)
