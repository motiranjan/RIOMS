                <span style="color:red">(+)@item.AdvanceAdjustmentWaterTax.Current</span>
            }
            </td>
        <td>

            @item.NetCollectionCess.Current
            @if (item.AdvanceAdjustmentCess!=null)
            {
                <span style="color:red">(+)@item.AdvanceAdjustmentCess.Current</span>
            }
        </td>
        <td></td>
        <td>
            @item.NetCollectionPartOneRev.Current
            @if (item.AdvanceAdjustmentPartOneRev != null)
            {
                <span style="color:red">(+)@item.AdvanceAdjustmentPartOneRev.Current </span>
            }
            <br />
            <span>---------</span>
            @item.NetCollectionWithAdvAdjPartOneRev.Current
        </td>
        <td>
            @if (item.BalanceLandRevenue.Arrear>0)
            {
                @item.BalanceLandRevenue.Arrear
            }
        </td>
        <td>@if (item.BalanceWaterTax.Arrear>0)
            {
                @item.BalanceWaterTax.Arrear
            }</td>

        <td>
           @if (item.BalanceCess.Arrear>0)
           {
                @item.BalanceCess.Arrear
           }

        </td>
        <td></td>
        <td>
            @item.BalancePartOneRev.Arrear
        </td>
        <td>@if (item.BalanceLandRevenue.Current>0)
            {
                @item.BalanceLandRevenue.Current
            }</td>
        <td>@if (item.BalanceWaterTax.Current>0)
            {
                @item.BalanceWaterTax.Current
            }</td>
        <td>

            @item.BalanceCess.Current

        </td>
        <td></td>
        <td>
            @item.BalancePartOneRev.Current
        </td>
            <td>@item.AdvanceCollectionLandRevenue.Total</td>
            <td>@item.AdvanceCollectionWaterTax.Total</td>
            <td>@item.AdvanceCollectionCess.Total</td>
    </tr>
