    @{int index = 0;
    }
    @foreach (var item in Model.DCBViewModels)
    {
        index++;
        <tr>
            <td>
                @index
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Village.Name)
            </td>
            <td>
                @if (item.DemandLandRevenue.Arrear > 0)
                {
                    @item.DemandLandRevenue.Arrear
                }
                @if (item.IncreaseInDemandLandRevenue != null)
                {
                    <span style="color:red;">+@item.IncreaseInDemandLandRevenue.Arrear</span>

                  <br />
                  <span>-------</span>
                  <br />
                  <span>@item.DemandAfterIncreaseLandRevenue.Arrear</span>
                      }
            </td>
            <td>@if (item.DemandWaterTax.Arrear>0)
                {
                    @item.DemandWaterTax.Arrear
                }</td>

            <td>
                @if (item.DemandCess.Arrear > 0)
                {
                    @item.DemandCess.Arrear
                }
                @if (item.IncreaseInDemandCess != null)
                {
                    <span style="color:red;">+@item.IncreaseInDemandCess.Arrear</span>
                    <br />
                    <span>-----------</span>
                    <span>@item.DemandAfterIncreaseCess.Arrear</span>
                }
            </td>
