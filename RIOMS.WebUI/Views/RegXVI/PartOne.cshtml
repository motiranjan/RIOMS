    }
</td>
<td></td>
<td>
    @Model.TotalCollectionPartOneRev.Arrear
    @if (Model.TotalAdvanceAdjustmentPartOneRev.Arrear > 0)
    {
        <span>(+)@Model.TotalAdvanceAdjustmentPartOneRev.Arrear</span>
        <hr />
