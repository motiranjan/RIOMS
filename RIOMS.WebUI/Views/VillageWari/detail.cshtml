                </td>
                @*<td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Third)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Second)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Previous)
                    </td>*@
                <td>
                    @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Arrear)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Current)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => previousTotal.CollectionCess.Total)
