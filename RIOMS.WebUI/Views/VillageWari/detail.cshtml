            </tr>

            grandTotal = previousTotal + total;

            <tr class="total">
                <td colspan="5">Grand Total</td>
                @*<td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionLandRevenue.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => grandTotal.CollectionLandRevenue.Third)
