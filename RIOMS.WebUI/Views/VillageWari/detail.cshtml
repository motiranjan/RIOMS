                <td>@Html.DisplayFor(modelItem => previousTotal.CollectionLandRevenue.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => previousTotal.CollectionWaterTax.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => previousTotal.CollectionCess.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => previousTotal.CollectionMiscRevenue.Interest)</td>
                <td>
                    @{
                        var otherpt = (previousTotal.HasOLR ? previousTotal.CollectionOLR.DemarcationFee : 0) + (previousTotal.HasOthers ? previousTotal.CollectionOther.Amount : 0);
                    }
                    @if (otherpt > 0)
                    {
                        @otherpt
                    }
                </td>
                <td>
                    @{var pt = previousTotal.HasOLR ? previousTotal.Total - previousTotal.CollectionOLR.Premium : previousTotal.Total;}
                    @pt
