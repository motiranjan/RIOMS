    @{
        Receipt total;
        Receipt grandTotal = null;
        Receipt previousTotal = null;
    }
    @for (int i = 0; i < Model.Totals.Count(); i++)
    {
        total = Model.Totals.ElementAt(i);

        if (i == 0)
        {
            grandTotal = total;
        }
        var receipts = Model.Receipts.Where(r => r.Date == total.Date).OrderBy(r=>r.ReceiptNo).ToList();
        foreach (var item in receipts)
        {

            var index = receipts.IndexOf(item);
            <tr class="@(index % 2 == 0 ? "row-even" : "row-odd")">
                <td>@(index + 1)</td>
                <td class="date">
                    @item.Date.ToString("dd/MM/yy")
                </td>
                <td class="nameOfRT">@Html.DisplayFor(modelItem => item.ReceiptNo)</td>
                @if (item.HasMiscRevenue)
                {
                    <td colspan="2">@item.CollectionMiscRevenue.Type <span>case No</span> @item.CollectionMiscRevenue.CaseNo </td>
                }
                else
                {
                    <td>
                        @Html.DisplayFor(modelItem => item.NameOfRT)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.KhataNo)
                    </td>

                }
                @*<td>
                        @Html.DisplayFor(modelItem => item.CollectionLandRevenue.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionLandRevenue.Third)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionLandRevenue.Second)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionLandRevenue.Previous)
                    </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.CollectionLandRevenue.Arrear)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CollectionLandRevenue.Current)
                </td>

                <td>@Html.DisplayFor(modelItem => item.CollectionLandRevenue.Total)</td>
                @*<td>
                        @Html.DisplayFor(modelItem => item.CollectionWaterTax.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionWaterTax.Third)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionWaterTax.Second)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionWaterTax.Previous)
                    </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.CollectionWaterTax.Arrear)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CollectionWaterTax.Current)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.CollectionWaterTax.Total)
                </td>
                @*<td>
                        @Html.DisplayFor(modelItem => item.CollectionCess.MoreThanThree)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionCess.Third)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionCess.Second)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CollectionCess.Previous)
                    </td>*@
                <td>
                    @Html.DisplayFor(modelItem => item.CollectionCess.Arrear)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CollectionCess.Current)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.CollectionCess.Total)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CollectionMiscRevenue.Arrear)
                </td>
                <td>
                    @{decimal mc = item.CollectionMiscRevenue != null ? item.CollectionMiscRevenue.Current : 0;
                        decimal op = item.CollectionOLR != null ? item.CollectionOLR.Premium.Value : 0;
                    }
                    @(mc+op)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.CollectionMiscRevenue.Total)
                </td>
                <td>@Html.DisplayFor(modelItem => item.CollectionLandRevenue.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => item.CollectionWaterTax.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => item.CollectionCess.InterestTotal)</td>
                <td>@Html.DisplayFor(modelItem => item.CollectionMiscRevenue.Interest)</td>
                <td>
                    @{
                        var other = (item.HasOLR ? item.CollectionOLR.DemarcationFee : 0) + (item.HasOthers ? item.CollectionOther.Amount : 0);
                    }
                    @if (other > 0)
                    {
                        @other
                    }
                </td>
                <td>
                    @{var t = item.HasOLR ? item.Total - item.CollectionOLR.Premium : item.Total;}
                    @t
                </td>
            </tr>
        }



        <tr class="total">
            <td colspan="5">ମୋଟ</td>
            @*<td>
                    @Html.DisplayFor(modelItem => total.CollectionLandRevenue.MoreThanThree)
