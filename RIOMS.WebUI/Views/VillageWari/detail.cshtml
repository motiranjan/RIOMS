@using RIOMS.Domain.Models;
@model RIOMS.WebUI.Models.VillageWariViewModel

@{
    ViewBag.Title = ViewBag.Village.Name;
}

<h2>@ViewBag.Village.Name</h2>
<table class="villageWari">
    <tr>
        <th rowspan="2">Sl No.</th>
        <th rowspan="2" class="date">
            Date
        </th>
        <th rowspan="2">
            Receipt No
        </th>
        <th rowspan="2">
            Name Of Tanent
        </th>
        <th rowspan="2">
            Khata No
        </th>

        <th colspan="3">
            Land Revenue
        </th>
        <th colspan="3">
            Water Tax
        </th>
        <th colspan="3">
            Cess
        </th>
        <th colspan="3">
            Misc Rev
        </th>
        <th rowspan="2">Interest On LR</th>
        <th rowspan="2">Interest On CBWR</th>
        <th rowspan="2">Interest On Cess</th>
        <th rowspan="2">Interest On Misc Rev</th>
        <th>Other</th>
        <th rowspan="2">Grand Total</th>
    </tr>
    <tr>
