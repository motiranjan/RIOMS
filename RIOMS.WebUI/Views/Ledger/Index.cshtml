@model RIOMS.WebUI.Models.LedgerViewModel

@{
    ViewBag.Title = "Ledger";
}
<div ng-app="RIOMS" ng-controller="LedgerController" id="ledger">
    <div>
        Year <select ng-model="Year">
    <option value="2014-2015">2014-2015</option>
    <option value="2015-2016">2015-2016</option>
    <option value="2016-2017">2016-2017</option>
    <option value="2017-2018">2017-2018</option>
    <option value="2018-2019">2018-2019</option>
    <option value="2019-2020">2019-2020</option>
    <option value="2020-2021">2020-2021</option>
</select>
        Village @Html.DropDownList("village", (SelectList)ViewBag.Villages, new { ng_model = "VillageId", Tabindex = "1", autofocus = true }) &nbsp;&nbsp;Khata NO:<input type="text" ng-model="KhataNo" />
        <input type="button" name="name" value="Show" ng-click="GetLedger(KhataNo,VillageId,Year)" tabindex="2" />
        <input type="button" name="name" value="Next" ng-click="NextKhata(KhataNo,VillageId,Year)" accesskey="n" />
    </div>
    <table id="part1">
        <tr>
            <th>Year</th>
            <th>Area</th>
            <td>
            </td>
            <th>Rent</th>
            <th>Water Tax</th>
            <th>Cess</th>
            <th>Total</th>
            <td rowspan="2">
                <table class="ledger-part1">
                    <tr>
                        <td>
                            {{Khata.KhataNo}}&nbsp;&nbsp;{{Khata.Status}}
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <span style="font-family:ORBW-TTMuktaEN;font-size:24px;">{{Khata.NameOfRT}}</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <th>{{Khata.DemandCesses[0].Year}}</th>
            <td>{{Khata.TotalArea | number : 2}}</td>
            <td>{{Khata.SpecialCase}}</td>
            <td>{{Khata.Khajana}}</td>
            <td>{{Khata.JalaKara}}</td>
            <td>
                As per ROR {{Khata.Cess}}
                As per Ledger
                <span ng-if="!IsEditable" ng-show="Khata.DemandCesses[0].Annual>0">{{Khata.DemandCesses[0].Annual | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandCesses[0].Annual" ng-if="IsEditable" tabindex="2" />
            </td>
            <td></td>
        </tr>
    </table>
    <br />
    <table style="float:left">
        <tr>
            <th rowspan="2">Date</th>
            <th rowspan="2">ReceiptNo</th>
            <th colspan="6">Land Revenue</th>
            <th colspan="6">WaterTax</th>
            <th colspan="6">Cess</th>
        </tr>
        <tr>

            <th>
                More Than Three
            </th>
            <th>
                Third
            </th>
            <th>
                Second
            </th>
            <th>
                Previous
            </th>
            <th>
                Current
            </th>
            <th>Advance</th>
            <th>
                More Than Three
            </th>
            <th>
                Third
            </th>
            <th>
                Second
            </th>
            <th>
                Previous
            </th>
            <th>
                Current
            </th>
            <th>Advance</th>
            <th>
                More Than Three
            </th>
            <th>
                Third
            </th>
            <th>
                Second
            </th>
            <th>
                Previous
            </th>
            <th>
                Current
            </th>
            <th>Advance</th>
        </tr>
        <tr class="demand" ng-i>
            <td>Demand</td>
            <td></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandLandRevenues[0].MoreThanThree>0">{{Khata.DemandLandRevenues[0].MoreThanThree | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandLandRevenues[0].MoreThanThree" ng-if="IsEditable" tabindex="12" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandLandRevenues[0].Third>0">{{Khata.DemandLandRevenues[0].Third | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandLandRevenues[0].Third" ng-if="IsEditable" tabindex="11" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandLandRevenues[0].Second>0">{{Khata.DemandLandRevenues[0].Second | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandLandRevenues[0].Second" ng-if="IsEditable" tabindex="10" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandLandRevenues[0].Previous>0">{{Khata.DemandLandRevenues[0].Previous | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandLandRevenues[0].Previous" ng-if="IsEditable" tabindex="9" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandLandRevenues[0].Current>0">{{Khata.DemandLandRevenues[0].Current | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandLandRevenues[0].Current" ng-if="IsEditable" tabindex="8" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandLandRevenues[0].Advance>0">{{Khata.DemandLandRevenues[0].Advance | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandLandRevenues[0].Advance" ng-if="IsEditable" /></td>

            <td><span ng-if="!IsEditable" ng-show="Khata.DemandWaterTaxes[0].MoreThanThree>0">{{Khata.DemandWaterTaxes[0].MoreThanThree | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandWaterTaxes[0].MoreThanThree" ng-if="IsEditable" tabindex="12" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandWaterTaxes[0].Third>0">{{Khata.DemandWaterTaxes[0].Third | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandWaterTaxes[0].Third" ng-if="IsEditable" tabindex="11" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandWaterTaxes[0].Second>0">{{Khata.DemandWaterTaxes[0].Second | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandWaterTaxes[0].Second" ng-if="IsEditable" tabindex="10" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandWaterTaxes[0].Previous>0">{{Khata.DemandWaterTaxes[0].Previous | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandWaterTaxes[0].Previous" ng-if="IsEditable" tabindex="9" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandWaterTaxes[0].Current>0">{{Khata.DemandWaterTaxes[0].Current | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandWaterTaxes[0].Current" ng-if="IsEditable" tabindex="8" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandWaterTaxes[0].Advance>0">{{Khata.DemandWaterTaxes[0].Advance | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandWaterTaxes[0].Advance" ng-if="IsEditable" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandCesses[0].MoreThanThree>0">{{Khata.DemandCesses[0].MoreThanThree | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandCesses[0].MoreThanThree" ng-if="IsEditable" tabindex="7" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandCesses[0].Third>0">{{Khata.DemandCesses[0].Third | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandCesses[0].Third" ng-if="IsEditable" tabindex="6" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandCesses[0].Second>0">{{Khata.DemandCesses[0].Second | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandCesses[0].Second" ng-if="IsEditable" tabindex="5" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandCesses[0].Previous>0">{{Khata.DemandCesses[0].Previous | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandCesses[0].Previous" ng-if="IsEditable" tabindex="4" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandCesses[0].Current>0">{{Khata.DemandCesses[0].Current | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandCesses[0].Current" ng-if="IsEditable" tabindex="3" /></td>
            <td><span ng-if="!IsEditable" ng-show="Khata.DemandCesses[0].Advance>0">{{Khata.DemandCesses[0].Advance | number : 2}}</span><input type="text" name="name" ng-model="Khata.DemandCesses[0].Advance" ng-if="IsEditable" tabindex="2" /></td>
            <td><a href="#" ng-click="AllowEdit()" ng-if="!IsEditable" accesskey="e">Edit</a><a href="#" ng-click="Update()" ng-if="IsEditable" accesskey="s">Update</a></td>
        </tr>
        <tr ng-repeat="receipt in Khata.Receipts" ng-if="receipt.HasCess || receipt.HasWaterTax">
            <td>{{receipt.Date | date:'dd/MM/yyyy'}}</td>
            <td>{{receipt.ReceiptNo}}</td>
            <td><span ng-show="receipt.CollectionLandRevenue.MoreThanThree>0">{{receipt.CollectionLandRevenue.MoreThanThree | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionLandRevenue.Third>0">{{receipt.CollectionLandRevenue.Third | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionLandRevenue.Second>0">{{receipt.CollectionLandRevenue.Second | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionLandRevenue.Previous>0">{{receipt.CollectionLandRevenue.Previous | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionLandRevenue.Current>0">{{receipt.CollectionLandRevenue.Current | number : 2}}</span></td>
            <td></td>

            <td><span ng-show="receipt.CollectionWaterTax.MoreThanThree>0">{{receipt.CollectionWaterTax.MoreThanThree | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionWaterTax.Third>0">{{receipt.CollectionWaterTax.Third | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionWaterTax.Second>0">{{receipt.CollectionWaterTax.Second | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionWaterTax.Previous>0">{{receipt.CollectionWaterTax.Previous | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionWaterTax.Current>0">{{receipt.CollectionWaterTax.Current | number : 2}}</span></td>
            <td></td>
            <td><span ng-show="receipt.CollectionCess.MoreThanThree>0">{{receipt.CollectionCess.MoreThanThree | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionCess.Third>0">{{receipt.CollectionCess.Third | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionCess.Second>0">{{receipt.CollectionCess.Second | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionCess.Previous>0">{{receipt.CollectionCess.Previous | number : 2}}</span></td>
            <td><span ng-show="receipt.CollectionCess.Current>0">{{receipt.CollectionCess.Current | number : 2}}</span></td>
            <td></td>
        </tr>
        <tr ng-if="Khata.Receipts.length==0">
            <td></td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td></td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
            <td>--</td>
        </tr>
        <tr>
            <td>Balance</td>
            <td></td>
            <td><span ng-show="Khata.BalanceLandRevenue.MoreThanThree>0">{{Khata.BalanceLandRevenue.MoreThanThree | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceLandRevenue.Third>0">{{Khata.BalanceLandRevenue.Third | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceLandRevenue.Second>0">{{Khata.BalanceLandRevenue.Second | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceLandRevenue.Previous>0">{{Khata.BalanceLandRevenue.Previous | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceLandRevenue.Current>0">{{Khata.BalanceLandRevenue.Current | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceLandRevenue.Advance>0">{{Khata.BalanceLandRevenue.Advance | number : 2}}</span></td>

            <td><span ng-show="Khata.BalanceWaterTax.MoreThanThree>0">{{Khata.BalanceWaterTax.MoreThanThree | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceWaterTax.Third>0">{{Khata.BalanceWaterTax.Third | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceWaterTax.Second>0">{{Khata.BalanceWaterTax.Second | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceWaterTax.Previous>0">{{Khata.BalanceWaterTax.Previous | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceWaterTax.Current>0">{{Khata.BalanceWaterTax.Current | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceWaterTax.Advance>0">{{Khata.BalanceWaterTax.Advance | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceCess.MoreThanThree>0">{{Khata.BalanceCess.MoreThanThree | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceCess.Third>0">{{Khata.BalanceCess.Third | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceCess.Second>0">{{Khata.BalanceCess.Second | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceCess.Previous>0">{{Khata.BalanceCess.Previous | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceCess.Current>0">{{Khata.BalanceCess.Current | number : 2}}</span></td>
            <td><span ng-show="Khata.BalanceCess.Advance>0">{{Khata.BalanceCess.Advance | number : 2}}</span></td>
        </tr>
    </table>
</div>