                        @item.Second
                    }
                </td>
                <td>
                    @if (item.Previous > 0)
                    {
                        previous += item.Previous;
                        @item.Previous
                    }
                </td>
                <td>
                    @if (item.Current > 0)
                    {
                        current += item.Current;
                        @item.Current
                    }
                </td>

            </tr>
        }
        <tr class="total">
            <td>
                Total
            </td>
            <td>
                @if (Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.MoreThanThree) > 0)
                {

                    @Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.MoreThanThree)
                }
            </td>
            <td>
                @if (Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.Third) > 0)
