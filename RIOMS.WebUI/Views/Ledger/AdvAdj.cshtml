@model RIOMS.Domain.Village

@{
    ViewBag.Title = "AdvAdj";
}

<h2>AdvAdj @Model.Name</h2>



<div style="float:left;">
    Cess
    <table>
        <tr>
            <th>
                KhataNo
            </th>
          
            <th>
                Current
            </th>

        </tr>
        @{
            decimal moreThanThree = 0;
            decimal third = 0;
            decimal second = 0;
            decimal previous = 0;
            decimal current = 0;
        }
        @foreach (var item in Model.AdvanceAdjustmentCesses.OrderBy(ac => ac.KhataNo.Contains('/') ? Convert.ToInt32(ac.KhataNo.Substring(ac.KhataNo.IndexOf('/') + 1, ac.KhataNo.Contains('(') ? (ac.KhataNo.IndexOf('(') - (ac.KhataNo.IndexOf('/') + 1)) : (ac.KhataNo.Length - (ac.KhataNo.IndexOf('/') + 1)))) + Convert.ToInt32(ac.KhataNo.Substring(0, ac.KhataNo.IndexOf('/'))) : Convert.ToInt32(ac.KhataNo.Substring(0, ac.KhataNo.Length - (ac.KhataNo.IndexOf('/') + 1)))))
        {

            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.KhataNo)

                </td>
             
                <td>
                    @if (item.Current > 0)
                    {
                        current += item.Current.GetValueOrDefault();
                        @item.Current
                    }
                </td>

            </tr>
        }
        <tr class="total">
            <td>
                Total
            </td>
     
            <td>
                @if (current > 0)
                {
                    @current
                }
            </td>

        </tr>
    </table>
</div>
<div style="float:left;">
    Water
    <table>
        <tr>
            <th>
                KhataNo
            </th>
           
            <th>
                Current
            </th>

        </tr>

        @foreach (var item in Model.AdvanceAdjustmentWaterTaxes.OrderBy(ac => ac.KhataNo.Contains('/') ? Convert.ToInt32(ac.KhataNo.Substring(ac.KhataNo.IndexOf('/') + 1, ac.KhataNo.Contains('(') ? (ac.KhataNo.IndexOf('(') - (ac.KhataNo.IndexOf('/') + 1)) : (ac.KhataNo.Length - (ac.KhataNo.IndexOf('/') + 1)))) + Convert.ToInt32(ac.KhataNo.Substring(0, ac.KhataNo.IndexOf('/'))) : Convert.ToInt32(ac.KhataNo.Substring(0, ac.KhataNo.Length - (ac.KhataNo.IndexOf('/') + 1)))))
        {

            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.KhataNo)

                </td>
       
                <td>
                    @if (item.Current > 0)
                    {
                        current += item.Current.GetValueOrDefault();
                        @item.Current
                    }
                </td>

            </tr>
        }
        <tr class="total">
            <td>
                Total
            </td>
            
            <td>
                @if (Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.Current) > 0)
                {
                    @Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.Current)
                }
            </td>

        </tr>
    </table>
</div>



</div>
