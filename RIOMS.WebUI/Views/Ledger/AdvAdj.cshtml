                    @Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.Second)
                }
            </td>
            <td>
                @if (Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.Previous) > 0)
                {
                    @Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.Previous)
                }
            </td>
            <td>
                @if (Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.Current) > 0)
                {
                    @Model.AdvanceAdjustmentWaterTaxes.Sum(ac => ac.Current)
                }
            </td>

        </tr>
    </table>
</div>


