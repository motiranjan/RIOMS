        if (item.IFormDetailCesses.Count + item.IFormDetailLandRevenues.Count + item.IFormDetailWaterTaxes.Count > 0)
        {
            index = index + 1;
            <tr class="@(index%2==0? "row-even" : "row-odd")">
                <td>
                    @item.DepositeDate.ToString("dd/MM/yy")
                </td>
                <td>@Html.DisplayFor(modelItem => item.IFormNo)</td>

              
                
                <td>
                    @if (item.IFormDetailLandRevenues.ElementAtOrDefault(0).Arrear > 0)
                    {
                        @item.IFormDetailLandRevenues.ElementAtOrDefault(0).Arrear
                    }
                </td>
                <td>
                    @if (item.IFormDetailLandRevenues.ElementAtOrDefault(0).Current > 0)
                    {
                        @item.IFormDetailLandRevenues.ElementAtOrDefault(0).Current
                    }
                </td>

