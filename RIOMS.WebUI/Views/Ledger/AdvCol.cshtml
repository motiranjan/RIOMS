@model RIOMS.Domain.Models.Village

@{
    ViewBag.Title = "AdvCol";
}

<h2>AdvCol @Model.Name</h2>



<div style="float:left;">

    <table>
        <tr>
            <th colspan="7" style="text-align:center;font-size:12px">
                ଅଗ୍ରିମ ଅସୁଲି ସେସ
            </th>
        </tr>
        <tr>
            <th>କ୍ର ନଂ</th>
            <th>
                ଖାତା ନଂ
            </th>
            <th class="vertical">
                <span> ତିନି&nbsp;ବର୍ଷରୁ&nbsp;ଊର୍ଦ୍ଧ୍ଵ ବାକୀ</span>
            </th>
            <th class="vertical">
                ତୃତୀୟ&nbsp;ବର୍ଷର ବାକୀ
            </th>
            <th class="vertical">
                ଦ୍ଵିତୀୟ&nbsp;ବର୍ଷର ବାକୀ
            </th>
            <th class="vertical">
                ପୂର୍ବ&nbsp;ବର୍ଷର ବାକୀ
            </th>
            <th class="vertical">
                ହାଲ୍
            </th>

        </tr>
        @{
            decimal moreThanThree = 0;
            decimal third = 0;
            decimal second = 0;
            decimal previous = 0;
            decimal current = 0;
            int slNo = 1;
        }
        @foreach (var item in Model.AdvanceCollectionCesses.OrderBy(ac => ac.KhataNo.Contains('/') ? Convert.ToInt32(ac.KhataNo.Substring(ac.KhataNo.IndexOf('/') + 1, ac.KhataNo.Contains('(') ? (ac.KhataNo.IndexOf('(') - (ac.KhataNo.IndexOf('/') + 1)) : (ac.KhataNo.Length - (ac.KhataNo.IndexOf('/') + 1)))) + Convert.ToInt32(ac.KhataNo.Substring(0, ac.KhataNo.IndexOf('/'))) : Convert.ToInt32(ac.KhataNo.Substring(0, ac.KhataNo.Length - (ac.KhataNo.IndexOf('/') + 1)))))
        {

            <tr>
                <td>@(slNo++)</td>
                <td>
                    @Html.DisplayFor(modelItem => item.KhataNo)

                </td>
                <td>

                    @if (item.MoreThanThree > 0)
                    {
                        moreThanThree += item.MoreThanThree;
                        @item.MoreThanThree
                    }
                </td>
                <td>
                    @if (item.Third > 0)
                    {
                        third += item.Third;
                        @item.Third
                    }
                </td>
                <td>
                    @if (item.Second > 0)
                    {
                        second += item.Second;
                        @item.Second
                    }
                </td>
                <td>
                    @if (item.Previous > 0)
                    {
                        previous += item.Previous;
                        @item.Previous
                    }
                </td>
                <td>
                    @if (item.Current > 0)
                    {
                        current += item.Current;
                        @item.Current
                    }
                </td>

            </tr>
        }
        <tr class="total">
            <td colspan="2">
                ମୋଟ
            </td>
            <td>
                @if (moreThanThree > 0)
                {

                    @moreThanThree
                }
            </td>
            <td>
                @if (third > 0)
                {
                    @third
                }
            </td>
            <td>
                @if (second > 0)
                {
                    @second
                }
            </td>
            <td>
                @if (previous > 0)
                {
                    @previous
                }
            </td>
            <td>
                @if (current > 0)
                {
                    @current
                }
            </td>

        </tr>
    </table>
</div>
