            </td>
            <td>
                @if (Model.AdvanceCollectionLandRevenues.Sum(ac => ac.Previous) > 0)
                {
                    @Model.AdvanceCollectionLandRevenues.Sum(ac => ac.Previous)
                }
            </td>
            <td>
                @if (Model.AdvanceCollectionLandRevenues.Sum(ac => ac.Current) > 0)
                {
                    @Model.AdvanceCollectionLandRevenues.Sum(ac => ac.Current)
                }
            </td>

        </tr>
    </table>
</div>


    
