
@{
    ViewBag.Title = "Index";
}




    <div ng-app="RIOMS" ng-controller="ReceiptController">
        <div>

        </div>
        <input type="date" name="name" ng-model="CurrentDate" ng-change="ChangeDate()" />
        <table class="receipt">
            <tr>
                <td>{{Receipt.Date}}</td>
                <td>Written Villge</td>
                <td colspan="2">
                    @Html.DropDownList("village", (SelectList)ViewBag.Villages, new { ng_model = "Receipt.VillageId", ng_change = "GetKhata(Receipt)", Tabindex = "1", autofocus = true, ng_focus="NewReceipt" })
                </td>

                <td>khata No</td>
                <td>
                    <input type="text" ng-model="Receipt.KhataNo" ng-keyup="GetKhata(Receipt)" tabindex="2" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.ReceiptNo"  ng-keyup="GetReceiptByNo(Receipt.ReceiptNo)"  />
                </td>
            </tr>
            <tr>
                <td colspan="2">Name Of RT</td>

                <td colspan="6" class="nameOfRT">{{Receipt.NameOfRT}}</td>
            </tr>
            <tr>

                <td colspan="8"><label for="CollectionLandRevenue">Land Revenue</label>
                <input type="checkbox" id="CollectionLandRevenue" ng-model="Receipt.HasLandRevenue" ng-change="LoadLR(Receipt)" /> <label for="CollectionWaterTax">Water Tax</label><input type="checkbox" id="CollectionWaterTax" ng-model="Receipt.HasWaterTax" ng-change="LoadCBWR(Receipt)" /><label for="CollectionCess">CollectionCess</label><input type="checkbox" id="CollectionCess" ng-model="Receipt.HasCess" ng-change="LoadCess(Receipt)" /><label for="CollectionMiscRevenue">Misc Revenue</label><input type="checkbox" id="CollectionMiscRevenue" ng-model="Receipt.HasMiscRevenue" ng-change="LoadMiscRevenue(Receipt)" /><label for="CollectionOther">CollectionOther</label><input type="checkbox" id="CollectionOther" ng-model="Receipt.HasOthers" ng-change="LoadOthers(Receipt)" /></td>
            </tr>



            <tr>
                <td></td>
                <td>{{Receipt.HasMiscRevenue || Receipt.HasOthers?"Type":"years and above"}} </td>
                <td>{{Receipt.HasMiscRevenue || Receipt.HasOthers?"Case No":"Third Year"}}</td>
                <td>{{Receipt.HasMiscRevenue || Receipt.HasOthers?"":"Second"}}</td>
                <td>{{Receipt.HasOthers?"":"Previous"}}</td>
                <td>Current</td>
                <td>Total</td>
                <td>Interest</td>
            </tr>
            <tr ng-if="Receipt.HasLandRevenue">
                <td>Land Revenue</td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionLandRevenue.MoreThanThree" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionLandRevenue.Third" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionLandRevenue.Second" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionLandRevenue.Previous" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionLandRevenue.Current" />
                </td>
                <td>
                    {{Total(Receipt.CollectionLandRevenue).toFixed(2)}}
                </td>
                <td><input type="text" ng-model="Receipt.CollectionLandRevenue.InterestTotal" /></td>

            </tr>
            <tr ng-if="Receipt.HasWaterTax">
                <td>Water Tax</td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionWaterTax.MoreThanThree" tabindex="12" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionWaterTax.Third" tabindex="11" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionWaterTax.Second" tabindex="10" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionWaterTax.Previous" tabindex="9" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionWaterTax.Current" tabindex="8" />
                </td>
                <td>
                    {{Total(Receipt.CollectionWaterTax).toFixed(2)}}
                </td>
                <td><input type="text" ng-model="Receipt.CollectionWaterTax.InterestTotal" /></td>
            </tr>

            <tr ng-if="Receipt.HasCess">
                <td>
                    CollectionCess
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.MoreThanThree" tabindex="7" ng-change="CalcInt()" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.Third" tabindex="6" ng-change="CalcInt()" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.Second" tabindex="5" ng-change="CalcInt()" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.Previous" tabindex="4" ng-change="CalcInt()" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.Current" tabindex="3" />
                </td>
                <td>
                    {{Total(Receipt.CollectionCess).toFixed(2)}}
                </td>
                
            </tr>
            <tr ng-if="Receipt.HasCess">
                <td>
                    Int on CollectionCess
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.IntMoreThanThree" tabindex="7" ng-change="CalcInt()" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.IntThird" tabindex="6" ng-change="CalcInt()" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.IntSecond" tabindex="5" ng-change="CalcInt()" />
                </td>
                <td>
                    <input type="text" ng-model="Receipt.CollectionCess.IntPrevious" ng-change="CalcInt()" />
                </td>
                <td>
                    
                </td>
                <td>
                    {{Receipt.CollectionCess.InterestTotal.toFixed(2)}}
                </td>
                
            </tr>
            <tr ng-if="Receipt.HasMiscRevenue">
                <td>Misc Revenue</td>
                <td><select ng-model="Receipt.CollectionMiscRevenue.Type">
    <option value="Encroachment">Encroachment</option>
                        <option value="Bricks">Bricks Royalty</option>
</select></td>
                <td><input type="text"  ng-model="Receipt.CollectionMiscRevenue.CaseNo" /></td>
                <td></td>
                <td><input type="text" ng-model="Receipt.CollectionMiscRevenue.Arrear" /></td>
                <td><input type="text" ng-model="Receipt.CollectionMiscRevenue.Current" /></td>
                <td></td>
                <td><input type="text" ng-model="Receipt.CollectionMiscRevenue.Interest" /></td>
            </tr>
            <tr ng-if="Receipt.HasOthers">
                <td>Others</td>
                <td>
                    <select ng-model="Receipt.CollectionOther.Type">
                        <option value="DF">DF</option>
                        <option value="LPB">LPB</option>
                        <option value="OLRPremium">OLR Premium</option>
                        <option value="OPDR">OPDR</option>
                    </select>
                </td>
                <td><input type="text" ng-model="Receipt.CollectionOther.CaseNo" /></td>
                <td></td>
                <td></td>
                <td><input type="text" ng-model="Receipt.CollectionOther.Amount" /></td>
                <td></td>
                <td></td>
            </tr>
        </table>
        <input type="button" value="Save" ng-click="SaveReceipt()" accesskey="s" />
    </div>
    


