@{
    ViewBag.Title = "Index";
}


<div>
    @Html.ActionLink("2014-2015", "Index", "VillageWari", new { year = "2014-2015" }, null)
    @Html.ActionLink("2015-2016", "Index", "VillageWari", new { year = "2015-2016" }, null)
    @Html.ActionLink("2016-2017", "Index", "VillageWari", new { year = "2016-2017" }, null)
    @Html.ActionLink("2017-2018", "Index", "VillageWari", new { year = "2017-2018" }, null)
</div>

<table>
    <tr>
        <td>Ch No.</td>
        <td colspan="@ViewBag.Villages.Count">Villages</td>
    </tr>

   
        <tr>
           
            @foreach (Village village in ViewBag.Villages)
            {
                <td>
                    @Html.ActionLink(village.Name, "detail", new { iformNo = iform.IFormNo, year = iform.Year, vid = village.Id })
                </td>
            }
        </tr>
  
</table>