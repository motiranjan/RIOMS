@model RIOMS.Domain.Models.Village

@{
    ViewBag.Title = "Detail";
}

<h2>Detail</h2>


<table>
    <tr>
        <th>SL No.</th>
        <th>
            Name
        </th>
        <th>
            Father Name
        </th>
        <th>
            Type
        </th>

        <th>
            Case no.
        </th>
        <th>
            Amount
        </th>
        <th>
            ReceiptNo
        </th>
        <th>
            Date
        </th>
        <th>
            Amount
        </th>

        <th>
            Balance
        </th>
        <th>
            Interest
        </th>
       
    </tr>
    @{
      int arrearCout = 0;
      int currentCount = 0;
      
      bool isArrear = false;
     
      string color;
    }
    @foreach (var item in Model.DemandMiscRevenues)
    {
        
        isArrear = item.Arrear > 0;
        if (isArrear)
        {
            
            arrearCout++;
            color = "red";
        }
        else
        {
            
            currentCount++;
            color = "Black";
        }
        if (arrearCout>1 && currentCount==1)
        {
            <tr style="color:red;">
                <td colspan="5"></td>
                <td>@Model.DemandMiscRevenues.Sum(d => d.Arrear)</td>
                <td colspan="2"></td>
                <td>@(Model.Receipts.Sum(r=>r.CollectionMiscRevenue.Arrear)+Model.TahReceipts.Sum(r=>r.CollectionMiscRevenue.Arrear))</td>
               
                <td>@(Model.DemandMiscRevenues.Sum(m => m.Arrear) - (Model.Receipts.Sum(r => r.CollectionMiscRevenue.Arrear) + Model.TahReceipts.Sum(r => r.CollectionMiscRevenue.Arrear)))</td>
            </tr>
        }
        <tr>
            <td>@(isArrear?arrearCout:currentCount)</td>
            <td style="width: 100px; color: @color">
                @Html.DisplayFor(modelItem => item.MiscRevenue.Name)
            </td>
            <td style="color:@color">
                @Html.DisplayFor(modelItem => item.MiscRevenue.Father_HusbandName)
            </td>
            <td style="color:@color">
                @Html.DisplayFor(modelItem => item.MiscRevenue.TypesOfMiscRev.Name)
            </td>

            <td style="color:@color">
                @Html.DisplayFor(modelItem => item.MiscRevenue.CaseNo)/
                @Html.DisplayFor(modelItem => item.MiscRevenue.Year)
            </td>
            <td style="color:@color">
                @Html.DisplayFor(modelItem => item.MiscRevenue.Amount)
            </td>
            <td>
                @foreach (var receipt in item.MiscRevenue.Receipts)
                {
                    @Html.DisplayFor(modelItem => receipt.ReceiptNo)
                }
                @if (item.MiscRevenue.TahReceipts.Count > 0)
                {
                    @Html.Label("ନା:ର:ନଂ")
                }
                @foreach (var receipt in item.MiscRevenue.TahReceipts)
                {
                    @Html.DisplayFor(modelItem => receipt.ReceiptNo)
                }
            </td>
            <td>
                @foreach (var receipt in item.MiscRevenue.Receipts)
                {
                    @receipt.Date.ToShortDateString();

                }
                @foreach (var receipt in item.MiscRevenue.TahReceipts)
                {
                    @receipt.Date.ToShortDateString();

                }
            </td>
            <td>
                @foreach (var receipt in item.MiscRevenue.Receipts)
                {
                    @(receipt.CollectionMiscRevenue.Current + receipt.CollectionMiscRevenue.Arrear);

                }
               @foreach (var receipt in item.MiscRevenue.TahReceipts)
                {
                    @(receipt.CollectionMiscRevenue.Current + receipt.CollectionMiscRevenue.Arrear);

                }

            </td>

            <td>
                @{var balance = item.MiscRevenue.Amount - (item.MiscRevenue.Receipts.Sum(r => r.CollectionMiscRevenue.Arrear + r.CollectionMiscRevenue.Current) + item.MiscRevenue.TahReceipts.Sum(r => r.CollectionMiscRevenue.Arrear + r.CollectionMiscRevenue.Current));}
                @balance
            </td>
            <td>
                @*@Html.DisplayFor(modelItem => item.Interest)*@
            </td>
        </tr>

    }
    @if (currentCount == 0)
    {
       <tr style="color:red;">
                <td colspan="5"></td>
                <td>@Model.DemandMiscRevenues.Sum(d => d.Arrear)</td>
                <td colspan="2"></td>
                <td>@(Model.Receipts.Sum(r=>r.CollectionMiscRevenue.Arrear)+Model.TahReceipts.Sum(r=>r.CollectionMiscRevenue.Arrear))</td>
           <td>@(Model.DemandMiscRevenues.Sum(m => m.Arrear) - (Model.Receipts.Sum(r => r.CollectionMiscRevenue.Arrear) + Model.TahReceipts.Sum(r => r.CollectionMiscRevenue.Arrear)))</td>
            </tr>
    }
    @if (currentCount > 0)
    {
       <tr style="color:red;">
                <td colspan="5"></td>
                <td>@Model.DemandMiscRevenues.Sum(d => d.Current)</td>
                <td colspan="2"></td>
                <td>@(Model.Receipts.Sum(r=>r.CollectionMiscRevenue.Current)+Model.TahReceipts.Sum(r=>r.CollectionMiscRevenue.Current))</td>
                <td>@(Model.DemandMiscRevenues.Sum(m => m.Current) - (Model.Receipts.Sum(r => r.CollectionMiscRevenue.Current) + Model.TahReceipts.Sum(r => r.CollectionMiscRevenue.Current)))</td>
            </tr>
    }
</table>
