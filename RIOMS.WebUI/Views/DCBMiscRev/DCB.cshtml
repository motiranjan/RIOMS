@model RIOMS.WebUI.Models.DCBMiscRevViewModel

@{
    ViewBag.Title = "DCB"+ViewBag.VillageName;
}

<h2>DCB @ViewBag.VillageName</h2>
<table>
    <tr>
      
        <th class="date">Date</th>
        <th>Chalan No.</th>
        <th>Arrear</th>
        <th>Current</th>
        <th>Total</th>
    </tr>
    <tr style="color:red;">
        <th colspan="2">Demand</th>
        <td>@Model.Demand.Arrear</td>
        <td>@Model.Demand.Current</td>
        <td>@(Model.Demand.Arrear+Model.Demand.Current)</td>
    </tr>
    @{decimal totalArrearCollection = 0;
    decimal totalCurrentCollection = 0;
    decimal totalCollection = 0;}
    @foreach (var item in Model.IFormDetailMiscRevenues)
    {
       
            <tr>
                <td class="date">@item.DepositeDate.ToShortDateString()</td>
                <td>@item.IFormNo</td>
               
                <td>
                    @if (item.Arrear > 0)
                    {
                        @item.Arrear
                    }
            </td>
            <td>
                @if (item.Current > 0)
                {
                    @item.Current
                }
        </td>
        <td>
            @{var total = item.Arrear + item.Current;}
        @total
    </td>
</tr>
     
    }
    <tr class="total">
        <th colspan="2">
            Total
        </th>
        <td>@Model.TotalCollection.Arrear</td>
        <td>@Model.TotalCollection.Current</td>
        <td>@(Model.TotalCollection.Arrear+Model.TotalCollection.Current)</td>
    </tr>
    @if (Model.GoToVillage.Count()+Model.ComeFromVilllage.Count()>0)
    {
        foreach (var item in Model.ComeFromVilllage)
 {
      <tr>
     <th colspan="2">
      came from   @item.FromVillage.Name 
     </th>
          <td >@item.Arrear</td>
          <td>@item.Current</td>
          <td>@(item.Arrear+item.Current)</td>
  </tr>
 }
    
    foreach (var item in Model.GoToVillage)
    {
        <tr>
            <th colspan="2">
                Went To   @item.ToVillage.Name
            </th>
            <td>@item.Arrear</td>
            <td>@item.Current</td>
            <td>@(item.Arrear + item.Current)</td>
        </tr>
    }
        <tr class="total">
         <th colspan="2">
          Total
        </th>
        <td>@Model.TotalCollectionAfterMovement.Arrear</td>
        <td>@Model.TotalCollectionAfterMovement.Current</td>
        <td>@(Model.TotalCollectionAfterMovement.Arrear + Model.TotalCollectionAfterMovement.Current)</td>
    </tr>
    }
    @if (Model.HasTahCollection)
    {
        <tr>
            <th colspan="2">
                Tah Collection
            </th>
            <td>@Model.TahCollection.Arrear</td>
            <td>@Model.TahCollection.Current</td>
            <td>@(Model.TahCollection.Arrear + Model.TahCollection.Current)</td>
        </tr>
    }
         <tr>
       
    <tr class="total">
        <th colspan="2" >
          Total
        </th>
        <td>@Model.TotalCollectionAfterTah.Arrear</td>
        <td>@Model.TotalCollectionAfterTah.Current</td>
        <td>@(Model.TotalCollectionAfterTah.Arrear + Model.TotalCollectionAfterTah.Current)</td>
    </tr>
    <tr>
        <th colspan="2">
            Balance
        </th>
        <td>
           @Model.Balance.Arrear
    </td>
    <td>
        @Model.Balance.Current
</td>
<td>
    @{decimal totalBalance = (Model.Demand.Current+Model.Demand.Arrear) - (Model.TotalCollectionAfterTah.Current+Model.TotalCollectionAfterTah.Arrear);
    if (totalBalance == Model.Balance.Current + Model.Balance.Arrear)
    {
        @totalBalance
    }
    else
    {
        @Html.Raw("Error");
    }
}
</td>
</tr>
</table>