@using RIOMS.WebUI.Models;
@model IEnumerable<DCBMiscRevViewModel>

@{
    ViewBag.Title = "Abstract";
}

<h2>Abstract</h2>


<table>
    <tr>
        <th rowspan="2">Sl No.</th>
        <th rowspan="2">Name of Village</th>
        <th colspan="3">Demand</th>
        <th colspan="3">Collection</th>
        <th colspan="3">Balance</th>
    </tr>
    <tr>
        <th>Arrear</th>
        <th>Current</th>
        <th>Total</th>
        <th>Arrear</th>
        <th>Current</th>
        <th>Total</th>
        <th>Arrear</th>
        <th>Current</th>
        <th>Total</th>
    </tr>
    @{int slNo = 0;}
@foreach (DCBMiscRevViewModel item in Model) {
   if (item.Demand.Arrear + item.Demand.Current>0)
   {
        <tr>
       <td>@{slNo++;} @slNo</td>
        <td>@item.VillageName</td>
        <td>@if (item.Demand.Arrear>0)
            {
                @item.Demand.Arrear
            }</td>
        <td>@if (item.Demand.Current>0)
            {
                @item.Demand.Current
            }</td>
        <td>@(item.Demand.Arrear+item.Demand.Current)</td>
        <td>@if (item.TotalCollectionAfterTah.Arrear>0)
            {
                @item.TotalCollectionAfterTah.Arrear
            }</td>
        <td>@if (item.TotalCollectionAfterTah.Current>0)
            {
                @item.TotalCollectionAfterTah.Current
            }</td>
        <td>@(item.TotalCollectionAfterTah.Arrear+item.TotalCollectionAfterTah.Current)</td>
        <td>@if (item.Balance.Arrear>0)
            {
                @item.Balance.Arrear
            }</td>
        <td>@if (item.Balance.Current>0)
            {
                @item.Balance.Current
            }</td>
        <td>@(item.Balance.Arrear+item.Balance.Current)</td>
    </tr>
   }
}
    <tr class="total">
        <td colspan="2"></td>
        
        <td>@Model.Sum(d=>d.Demand.Arrear)</td>
        <td>@Model.Sum(d=>d.Demand.Current)</td>
        <td>@Model.Sum(d=>d.Demand.Current+d.Demand.Arrear)</td>
        <td>@Model.Sum(d=>d.TotalCollectionAfterTah.Arrear)</td>
        <td>@Model.Sum(d=>d.TotalCollectionAfterTah.Current)</td>
        <td>@Model.Sum(d=>d.TotalCollectionAfterTah.Current+d.TotalCollectionAfterTah.Arrear)</td>
        <td>@Model.Sum(d=>d.Balance.Arrear)</td>
        <td>@Model.Sum(d=>d.Balance.Current)</td>
        <td>@Model.Sum(d=>d.Balance.Current+d.Balance.Arrear)</td>
    </tr>
</table>
