@model IEnumerable<RIOMS.Domain.KhataWithArea>

@{
    ViewBag.Title = "Area";
}

    

<table>
    <tr>
        <th colspan="3" style="text-align:center;" >
            Large Farmers of @ViewBag.VillageName 
        </th>
    </tr>
    <tr>
        <th style="width:30px;">
            @Html.DisplayNameFor(model => model.KhataNo)
        </th>
        <th style="width:650px;">
            @Html.DisplayNameFor(model => model.NameOfRT)
        </th>
        <th style="width:30px;">
            @Html.DisplayNameFor(model => model.Area)
        </th>
        
    </tr>

@foreach (var item in Model.Where(k=>k.Area>Convert.ToDecimal(24.70))) {
    <tr>
        
        <td>
            @Html.DisplayFor(modelItem => item.KhataNo)
        </td>
        <td style="width:350px;">
            @Html.DisplayFor(modelItem => item.NameOfRT)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Area)
        </td>
       
    </tr>
}
