@model IEnumerable<RIOMS.Domain.KhataWithArea>


@ViewBag.Title
<table style="text-align:center;">
    <tr>
        <th rowspan="2" style="width:20px;">Sl No</th>
        <th rowspan="2">
            Khata No
        </th>

        
        <th rowspan="2">
            Total Area of Khata
        </th>
        <th colspan="3">Paddy Area</th>
        <th style="width:250px" rowspan="2">
            Name of RT
        </th>
        <th rowspan="2" style="width:250px;">Head Of Each Family</th>
        <th colspan="4">Bank Account Detail</th>
    </tr>
    <tr>
        
        <th>
            Autumn
        </th>
        <th>
          Winter
        </th>
        <th>
            Total
        </th>
        <th style="width:20px">Bank Name</th>
        <th>Branch Name</th>
        <th style="width:100px;">Account No</th>
        <th style="width:100px;">IFSC CODE</th>
    </tr>
    <tr>
        <th>	1	</th>
        <th>	2	</th>
        <th>	3	</th>
        <th>	4	</th>
        <th>	5	</th>
        <th>	6	</th>
        <th>	7	</th>
        <th>	8	</th>
        <th>	9	</th>
        <th>	10	</th>
        <th>	11	</th>
        <th>	12	</th>

    </tr>
   @{int slNo = 1;}
@foreach (var item in Model)
{
    <tr>
        <td>
            @(slNo++)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.KhataNo)
        </td>
       
<td>@Html.DisplayFor(modelItem => item.TotalArea)</td>

        <td>
            @Html.DisplayFor(modelItem => item.MalArea)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.BahalArea)
        </td>
        <td>
           
            @Html.DisplayFor(modelItem => item.TotalCultivableArear)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NameOfRT)
        </td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
    </tr>
}

</table>
