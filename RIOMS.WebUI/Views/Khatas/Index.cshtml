@model IEnumerable<RIOMS.Domain.Village>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        
        <th style="width:400px;"></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
       
        <td>
            @Html.ActionLink("View MaSa Plots", "Kisam", new { year = 0, vid = item.Id, iformNo=0, kisam = 1 }) |
           @Html.ActionLink("View BaSa Plots", "Kisam", new { year = 0, vid = item.Id, iformNo=0, kisam = 2 }) |
        </td>
    </tr>
}

</table>
