<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
</head>
<body>
    <nav class="navbar navbar-inverse">
        <div class="container-fluid">
            <div class="navbar-header">
                <a class="navbar-brand" href="/">RIOMS</a>
            </div>
            <ul class="nav navbar-nav">

                @*<li class="dropdown">
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                Register
                <span class="caret"></span>
            </a>
            <ul class="dropdown-menu">
                <li><a href="#">RoR</a></li>
            </ul>
        </li>*@
                <li class="dropdown">
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        RoR
                        <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu">
                        <li>
                            @Html.ActionLink("View RoR", "Index", "RoR")
                        </li>
                        <li>
                            @Html.ActionLink("RTList", "RTList", "RoR")
                        </li>
                    </ul>
                  
                </li>
                <li>
                    @Html.ActionLink("Ledger", "Index", "Ledger")

                </li>
                <li>
                    @Html.ActionLink("Receipt", "index", "receipt")
                </li>

                <li>@Html.ActionLink("Sadarsiha", "index", "sadarsiha", new { Year = System.Configuration.ConfigurationManager.AppSettings["Year"].ToString() }, null)</li>
                <li>@Html.ActionLink("CashBook", "index", "CashBook", new { Year = System.Configuration.ConfigurationManager.AppSettings["Year"].ToString() }, null)</li>
                <li>
                    @Html.ActionLink("IForm", "index", "IForms", new { Year = System.Configuration.ConfigurationManager.AppSettings["Year"].ToString() }, null))
                </li>
                <li>
                    @Html.ActionLink("VillageWari", "index", "VillageWari", new { Year = System.Configuration.ConfigurationManager.AppSettings["Year"].ToString() }, null))
                </li>
                <li>
                    @Html.ActionLink("Reg IX", "index", "DCBMiscRev", new { Year = System.Configuration.ConfigurationManager.AppSettings["Year"].ToString() }, null))
                </li>
            </ul>
        </div>
    </nav>
    <div id="container" class="container-fluid">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/RIOMS")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
    <script>
        $('td').each(function () {
            if ($(this).text().trim() == '0.00' || $(this).text().trim() == '0') {
                $(this).text('');
            }
        });
    </script>
</body>
</html>